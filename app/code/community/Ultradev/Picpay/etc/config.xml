<?xml version="1.0"?>
<config>
    <modules>
        <Ultradev_Picpay>
            <version>1.0.0</version>
        </Ultradev_Picpay>
    </modules>
    <global>
        <models>
            <ultradev_picpay>
                <class>Ultradev_Picpay_Model</class>
            </ultradev_picpay>
        </models>
        <blocks>
            <ultradev_picpay>
                <class>Ultradev_Picpay_Block</class>
            </ultradev_picpay>
        </blocks>
        <helpers>
            <ultradev_picpay>
                <class>Ultradev_Picpay_Helper</class>
            </ultradev_picpay>
        </helpers>
        <resources>
            <ultradev_picpay_setup>
                <setup>
                    <module>Ultradev_Picpay</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
            </ultradev_picpay_setup>
        </resources>
        <events>
            <sales_model_service_quote_submit_success>
                <observers>
                    <ultradev_picpay_invoice_paid>
                        <type>singleton</type>
                        <class>ultradev_picpay/observer</class>
                        <method>invoiceIfPaid</method>
                    </ultradev_picpay_invoice_paid>
                </observers>
            </sales_model_service_quote_submit_success>
            <sales_convert_quote_payment_to_order_payment>
                <observers>
                    <ultradev_picpay_copy_card_token>
                        <type>singleton</type>
                        <class>ultradev_picpay/observer</class>
                        <method>copyCardToken</method>
                    </ultradev_picpay_copy_card_token>
                </observers>
            </sales_convert_quote_payment_to_order_payment>
            <sales_order_payment_cancel>
                <observers>
                    <ultradev_picpay_cancel_charge>
                        <type>singleton</type>
                        <class>ultradev_picpay/observer</class>
                        <method>cancelCharge</method>
                    </ultradev_picpay_cancel_charge>
                </observers>
            </sales_order_payment_cancel>
        </events>
    </global>
    <frontend>
        <routers>
            <ultradev_picpay>
                <use>standard</use>
                <args>
                    <module>Ultradev_Picpay</module>
                    <frontName>picpaycheckout</frontName>
                </args>
            </ultradev_picpay>
        </routers>
        <layout>
            <updates>
                <ultradev_picpay>
                    <file>ultradev_picpay.xml</file>
                </ultradev_picpay>
            </updates>
        </layout>
    </frontend>
    <default>
        <payment>
            <ultradev_picpay>
                <active>0</active>
                <model>ultradev_picpay/method</model>
                <title>PicPay</title>
                <allowspecific>0</allowspecific>
                <use_sandbox>1</use_sandbox>
                <api_url_production>https://checkout-api.picpay.com/</api_url_production>
                <api_url_sandbox>https://checkout-api-sandbox.picpay.com/</api_url_sandbox>
                <api_path_prefix>api/v1/</api_path_prefix>
                <sdk_url>https://checkout.picpay.com/cdn/pp-transparent-v1.0.0.js</sdk_url>
                <debug>1</debug>
                <verify_webhook>1</verify_webhook>
                <poll_sync>1</poll_sync>
                <enable_card>1</enable_card>
                <enable_pix>1</enable_pix>
                <enable_wallet>1</enable_wallet>
                <label_card>Cartão de crédito</label_card>
                <label_pix>Pix</label_pix>
                <label_wallet>Carteira PicPay (QR Code)</label_wallet>
                <cc_auto_capture>1</cc_auto_capture>
                <max_installments>10</max_installments>
                <minimum_installment_amount>5</minimum_installment_amount>
                <pix_expiration>30</pix_expiration>
                <order_status>pending</order_status>
                <paid_order_status>processing</paid_order_status>
                <paid_virtual_order_status>complete</paid_virtual_order_status>
                <street_line_street>1</street_line_street>
                <street_line_number>2</street_line_number>
                <street_line_complement>3</street_line_complement>
                <street_line_district>4</street_line_district>
            </ultradev_picpay>
        </payment>
    </default>
</config>
