<?php
/** @var Ultradev_Picpay_Block_Form $this */
$code  = $this->getMethodCode();
$types = $this->getTypes();
$installments = $this->getInstallments();
$sdk = $this->getSdkConfig();
$descriptions = [
    'card'   => 'Pague em até ' . count($installments) . 'x',
    'pix'    => 'Aprovação na hora',
    'wallet' => 'Pague com o saldo no app PicPay',
];
?>
<ul class="form-list picpay-form" id="payment_form_<?php echo $code ?>" style="display:none;"
    data-sdk-url="<?php echo $this->escapeHtml($sdk['sdk-url']) ?>"
    data-merchant="<?php echo $this->escapeHtml($sdk['merchant']) ?>"
    data-transparent-token="<?php echo $this->escapeHtml($sdk['transparent-token']) ?>">
    <li>
        <input type="hidden" name="payment[picpay_type]" id="<?php echo $code ?>_type" value="" />
        <input type="hidden" name="payment[picpay_card_token]" id="<?php echo $code ?>_card_token" value="" />
        <input type="hidden" name="payment[picpay_card_brand]" id="<?php echo $code ?>_card_brand" value="" />
        <input type="hidden" name="payment[picpay_card_last4]" id="<?php echo $code ?>_card_last4" value="" />

        <p class="picpay-hint">Escolha como pagar com PicPay</p>

        <?php foreach ($types as $type => $label): ?>
            <button type="button" class="picpay-sub" data-type="<?php echo $type ?>"
                    aria-expanded="false" aria-controls="picpay_panel_<?php echo $type ?>">
                <span class="picpay-sub-label"><?php echo $this->escapeHtml($label) ?></span>
                <span class="picpay-sub-desc"><?php echo $this->escapeHtml($descriptions[$type]) ?></span>
            </button>

            <div class="picpay-panel" id="picpay_panel_<?php echo $type ?>" style="display:none;">
                <?php if ($type === 'card'): ?>
                    <?php /* Campos do cartão SEM atributo name: nunca são enviados ao servidor. */ ?>
                    <div class="picpay-field">
                        <label for="<?php echo $code ?>_cc_number">Número do cartão</label>
                        <input type="text" inputmode="numeric" autocomplete="cc-number" maxlength="23"
                               id="<?php echo $code ?>_cc_number"
                               class="input-text required-entry validate-picpay-cc" />
                    </div>
                    <div class="picpay-field">
                        <label for="<?php echo $code ?>_cc_owner">Nome impresso no cartão</label>
                        <input type="text" autocomplete="cc-name"
                               id="<?php echo $code ?>_cc_owner"
                               class="input-text required-entry" />
                    </div>
                    <div class="picpay-row">
                        <div class="picpay-field">
                            <label for="<?php echo $code ?>_cc_exp">Validade (MM/AA)</label>
                            <input type="text" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="MM/AA"
                                   id="<?php echo $code ?>_cc_exp"
                                   class="input-text required-entry validate-picpay-exp" />
                        </div>
                        <div class="picpay-field">
                            <label for="<?php echo $code ?>_cc_cid">CVV</label>
                            <input type="text" inputmode="numeric" autocomplete="cc-csc" maxlength="4"
                                   id="<?php echo $code ?>_cc_cid"
                                   class="input-text required-entry validate-digits" />
                        </div>
                    </div>
                    <div class="picpay-field">
                        <label for="<?php echo $code ?>_cc_installments">Parcelas</label>
                        <select id="<?php echo $code ?>_cc_installments" name="payment[cc_installments]" class="required-entry">
                            <?php foreach ($installments as $n => $text): ?>
                                <option value="<?php echo (int) $n ?>"><?php echo $this->escapeHtml($text) ?></option>
                            <?php endforeach; ?>
                        </select>
                    </div>
                    <p class="picpay-busy" id="<?php echo $code ?>_busy" style="display:none;">Validando o cartão com segurança…</p>
                <?php elseif ($type === 'pix'): ?>
                    <p>Ao finalizar o pedido você verá o QR Code e o código Pix copia e cola.
                        O código vale por <?php echo max(1, (int) $this->getPicpayHelper()->getConfig('pix_expiration')) ?> minutos.</p>
                <?php else: ?>
                    <p>1. Finalize o pedido para gerar o QR Code.<br />
                        2. Abra o app PicPay e toque em Pagar.<br />
                        3. Escaneie o código e confirme o pagamento.</p>
                <?php endif; ?>
            </div>
        <?php endforeach; ?>

        <div class="picpay-field" id="picpay_taxvat_wrap" style="display:none;">
            <label for="<?php echo $code ?>_taxvat">CPF/CNPJ do pagador</label>
            <input type="text" inputmode="numeric" maxlength="18"
                   id="<?php echo $code ?>_taxvat" name="payment[picpay_taxvat]"
                   value="<?php echo $this->escapeHtml($this->getDefaultTaxvat()) ?>"
                   class="input-text required-entry validate-picpay-doc" />
        </div>
    </li>
</ul>
