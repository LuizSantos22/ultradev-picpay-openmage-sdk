{
    "name": "ultradev/picpay-openmage-sdk",
    "description": "PicPay Checkout (Cartão via SDK, Pix e Carteira/QR Code) para OpenMage 20.x / PHP 8.1+, adaptado do módulo oficial Magento 2",
    "type": "magento-module",
    "license": "MIT",
    "authors": [
        {
            "name": "UltraDev",
            "email": "contato@ultradev.com.br",
            "homepage": "https://ultradev.com.br"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "magento-hackathon/magento-composer-installer": "*"
    },
    "extra": {
        "magento-root-dir": "../../",
        "magento-deploystrategy": "copy",
        "auto-append-gitignore": true
    },
    "keywords": ["openmage", "magento", "picpay", "pix", "sdk", "checkout", "ultradev"]
}
